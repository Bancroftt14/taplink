# Kunci Rahasia Admin Portal (Default: bancroftt2026)
ADMIN_SECRET=bancroftt2026

# Database Mode (Opsional):
# Jika tidak diisi, sistem otomatis memakai local data/cards.json (Cocok untuk uji coba lokal).
# Untuk deploy ke Vercel (Produksi), buat project gratis di https://supabase.com dan isi kredensial di bawah ini:
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
